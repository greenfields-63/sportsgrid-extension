{
  "manifest_version": 3,
  "name": "SportsGrid Multi-Viewer",
  "version": "1.22",
  "description": "Legal 4-quadrant sports multi-viewer with corner speaker switcher, Alt+S quick audio switch, Alt+M menu, and Alt+C close.",
  "permissions": [
    "tabs",
    "scripting",
    "windows",
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-menu": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Open SportsGrid Setup Menu"
    },
    "sound-menu": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open Quick Audio Switcher"
    },
    "close-grid": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Close All Sports Grid Windows"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
